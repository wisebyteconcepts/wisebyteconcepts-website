{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["email", "role"]
    },
    "Service": {
      "title": "Service",
      "description": "Technical service offering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "caption": { "type": "string" },
        "header": { "type": "string" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "thumbnail": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Portfolio item or product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "repoUrl": { "type": "string" },
        "demoUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical capability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "TechStack": {
      "title": "Tech Stack",
      "description": "Technologies, frameworks, and tools in tech stack",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "classification": { "type": "string" },
        "iconType": { "type": "string", "enum": ["icon", "link", "image"] },
        "icon": { "type": "string" },
        "iconLink": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "classification", "iconType"]
    },
    "Classification": {
      "title": "Classification",
      "description": "Lookup classification category for tech stack",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "MediaItem": {
      "title": "Media Item",
      "description": "Image, video, or document asset in unified gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video", "file"] },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "altText": { "type": "string" },
        "caption": { "type": "string" },
        "folderId": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "number" },
        "mimeType": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "url"]
    },
    "MediaFolder": {
      "title": "Media Folder",
      "description": "Organizational category folder for media assets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "MediaCollection": {
      "title": "Media Collection",
      "description": "Curated collection of media items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "mediaIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "MediaAuditLog": {
      "title": "Media Audit Log",
      "description": "Audit record for media upload, replacement, move, or deletion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "mediaId": { "type": "string" },
        "mediaName": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "performedBy", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Store user profile information"
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Service definitions"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Portfolio projects"
    },
    "skills/{skillId}": {
      "schema": "Skill",
      "description": "Skill matrix items"
    },
    "tech_stacks/{stackId}": {
      "schema": "TechStack",
      "description": "Tech stack items"
    },
    "classifications/{classificationId}": {
      "schema": "Classification",
      "description": "Tech stack classification lookup items"
    },
    "media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Unified media files, images, videos, and documents"
    },
    "mediaFolders/{folderId}": {
      "schema": "MediaFolder",
      "description": "Media folder organizational tree"
    },
    "mediaCollections/{collectionId}": {
      "schema": "MediaCollection",
      "description": "Named collections of media assets"
    },
    "mediaAuditLogs/{logId}": {
      "schema": "MediaAuditLog",
      "description": "Security and activity audit logs for media actions"
    }
  }
}
